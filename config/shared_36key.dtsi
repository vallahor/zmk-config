/*
 * Shared logical 3x5+3 keymap for the Decatyl/Corne and Temper.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

&sk {
    quick-release;
    release-after-ms = <300>;
};

/ {
    macros {
        quick_tap: quick_tap {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_param_1to1>, <&macro_tap &kp MACRO_PLACEHOLDER>;
        };
    };

    behaviors {
        repeatable_symbol: repeatable_symbol {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <100>;
            quick-tap-ms = <0>;
            hold-trigger-key-positions = <>;
            bindings = <&kp>, <&quick_tap>;
        };
    };

    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <16 17>;
            layers = <0>;
            timeout-ms = <80>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
&kp Q  &kp W  &kp E  &kp R      &kp T               &kp Y           &kp U  &kp I      &kp O    &kp P
&kp A  &kp S  &kp D  &kp F      &kp G               &kp H           &kp J  &kp K      &kp L    &kp SEMICOLON
&kp Z  &kp X  &kp C  &kp V      &kp B               &kp N           &kp M  &kp COMMA  &kp DOT  &kp SLASH
              &mo 3  &kp SPACE  &kp LEFT_CONTROL    &sk LEFT_SHIFT  &mo 1  &mo 2
            >;
        };

        sym_layer {
            bindings = <
&repeatable_symbol EXCLAMATION EXCLAMATION  &repeatable_symbol PERCENT PERCENT       &repeatable_symbol AMPERSAND AMPERSAND      &repeatable_symbol HASH HASH    &kp GRAVE  &kp SINGLE_QUOTE  &repeatable_symbol DOUBLE_QUOTES DOUBLE_QUOTES  &repeatable_symbol LEFT_PARENTHESIS LEFT_PARENTHESIS  &repeatable_symbol RIGHT_PARENTHESIS RIGHT_PARENTHESIS  &repeatable_symbol UNDERSCORE UNDERSCORE
&repeatable_symbol AT_SIGN AT_SIGN          &kp LEFT_BRACKET                       &kp RIGHT_BRACKET                          &kp EQUAL                    &none      &repeatable_symbol CARET CARET    &repeatable_symbol ASTERISK ASTERISK         &repeatable_symbol LEFT_BRACE LEFT_BRACE         &repeatable_symbol RIGHT_BRACE RIGHT_BRACE         &repeatable_symbol COLON COLON
&repeatable_symbol TILDE TILDE              &kp MINUS                              &repeatable_symbol PLUS PLUS               &repeatable_symbol DOLLAR DOLLAR  &none      &kp BACKSLASH                     &repeatable_symbol PIPE PIPE              &repeatable_symbol LESS_THAN LESS_THAN          &repeatable_symbol GREATER_THAN GREATER_THAN       &repeatable_symbol QUESTION QUESTION
                                   &trans             &trans      &trans     &trans         &trans             &trans
            >;
        };

        nav_layer {
            bindings = <
&none         &none         &none             &caps_word      &none         &kp PAGE_UP    &kp HOME           &kp UP_ARROW    &kp END          &kp TAB
&kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp ESCAPE    &kp PAGE_DOWN  &kp LEFT_ARROW     &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp ENTER
&kp LC(Z)     &kp LC(X)     &kp LC(C)         &kp LC(V)       &kp SPACE     &none          &kp LC(BACKSPACE)  &kp BACKSPACE   &kp DELETE       &kp LC(DELETE)
                            &trans            &trans          &trans        &trans         &trans             &trans
            >;
        };

        num_layer {
            bindings = <
&kp LS(TAB)   &none         &none             &kp TAB         &kp LS(TAB)    &none   &kp N7  &kp N8  &kp N9  &none
&kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp ESCAPE     &none   &kp N4  &kp N5  &kp N6  &kp N0
&kp LC(Z)     &kp LC(X)     &kp LC(C)         &kp LC(V)       &kp SPACE      &none   &kp N1  &kp N2  &kp N3  &none
                            &trans            &trans          &trans         &trans  &trans  &trans
            >;
        };

        fn_layer {
            bindings = <
&bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1     &bt BT_SEL 2   &bt BT_DISC 0  &kp PRINTSCREEN  &kp F7  &kp F8  &kp F9  &kp F12
&kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp ESCAPE    &none            &kp F4  &kp F5  &kp F6  &kp F10
&kp LC(Z)     &kp LC(X)     &kp LC(C)         &kp LC(V)       &none         &none            &kp F1  &kp F2  &kp F3  &kp F11
                              &trans            &trans          &trans        &trans           &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        fn_layer_cond {
            if-layers = <3 2>;
            then-layer = <4>;
        };
    };
};
