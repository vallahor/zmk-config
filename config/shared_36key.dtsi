/*
 * Shared logical 3x5+3 keymap for the Decatyl/Corne and Temper.
 *
 * Bluetooth profile 0 selects macOS mode. Profiles 1 and 2 select PC mode.
 * The bottom-right key on either Fn layer switches OS mode without changing
 * the Bluetooth profile (useful for USB).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define PC_BASE 0
#define SYM 1
#define PC_NAV 2
#define PC_NUM 3
#define PC_FN 4
#define MAC_BASE 5
#define MAC_NAV 6
#define MAC_NUM 7
#define MAC_FN 8

&sk {
    quick-release;
    release-after-ms = <300>;
};

/ {
    macros {
        mac_bt: mac_bt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&to MAC_BASE>;
        };

        pc1_bt: pc1_bt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&to PC_BASE>;
        };

        pc2_bt: pc2_bt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&to PC_BASE>;
        };
    };

    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <16 17>;
            layers = <PC_BASE MAC_BASE>;
            timeout-ms = <80>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        pc_base_layer {
            bindings = <
&kp Q  &kp W  &kp E  &kp R      &kp T               &kp Y           &kp U  &kp I      &kp O    &kp P
&kp A  &kp S  &kp D  &kp F      &kp G               &kp H           &kp J  &kp K      &kp L    &kp SEMICOLON
&kp Z  &kp X  &kp C  &kp V      &kp B               &kp N           &kp M  &kp COMMA  &kp DOT  &kp SLASH
              &mo PC_NUM  &kp SPACE  &kp LEFT_CONTROL    &sk LEFT_SHIFT  &mo SYM  &mo PC_NAV
            >;
        };

        sym_layer {
            bindings = <
&kp EXCLAMATION  &kp PERCENT       &kp AMPERSAND      &kp HASH    &kp GRAVE  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE
&kp AT_SIGN      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp EQUAL   &none      &kp CARET         &kp ASTERISK       &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp COLON
&kp TILDE        &kp MINUS         &kp PLUS           &kp DOLLAR  &none      &kp BACKSLASH     &kp PIPE           &kp LESS_THAN         &kp GREATER_THAN       &kp QUESTION
                                      &trans             &trans      &trans  &trans            &trans             &trans
            >;
        };

        pc_nav_layer {
            bindings = <
&kp LC(LS(TAB))  &kp LS(TAB)  &kp TAB  &kp LC(TAB)  &kp LC(T)  &kp PAGE_UP    &kp HOME           &kp UP_ARROW    &kp END          &kp TAB
&kp LEFT_GUI      &kp LEFT_ALT &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp ESCAPE     &kp PAGE_DOWN  &kp LEFT_ARROW     &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp ENTER
&kp LC(Z)     &kp LC(X)     &kp LC(C)         &kp LC(V)       &kp SPACE      &none          &kp LC(BACKSPACE)  &kp BACKSPACE   &kp DELETE       &kp LC(DELETE)
                              &trans            &trans          &trans         &trans         &trans             &trans
            >;
        };

        pc_num_layer {
            bindings = <
&kp LC(LS(TAB))  &kp LS(TAB)  &kp TAB  &kp LC(TAB)  &none   &none   &kp N7  &kp N8  &kp N9  &none
&kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp ESCAPE     &none   &kp N4  &kp N5  &kp N6  &kp N0
&kp LC(Z)     &kp LC(X)     &kp LC(C)         &kp LC(V)       &kp SPACE      &none   &kp N1  &kp N2  &kp N3  &none
                              &trans            &trans          &trans         &trans  &trans  &trans
            >;
        };

        pc_fn_layer {
            bindings = <
&bt BT_CLR    &mac_bt       &pc1_bt           &pc2_bt        &bt BT_DISC 0  &kp PRINTSCREEN  &kp F7  &kp F8  &kp F9  &kp F12
&kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT &kp ESCAPE    &none            &kp F4  &kp F5  &kp F6  &kp F10
&kp LC(Z)     &kp LC(X)     &kp LC(C)         &kp LC(V)      &none         &none            &kp F1  &kp F2  &kp F3  &to MAC_BASE
                              &trans            &trans         &trans        &trans           &trans  &trans
            >;
        };

        /* Transparent keys fall through to the PC base; layer selectors differ. */
        mac_base_layer {
            bindings = <
&trans  &trans  &trans  &trans       &trans              &trans          &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans       &trans              &trans          &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans       &trans              &trans          &trans  &trans     &trans  &trans
                &mo MAC_NUM  &trans  &kp LEFT_CONTROL    &trans          &trans  &mo MAC_NAV
            >;
        };

        mac_nav_layer {
            bindings = <
&none  &kp LC(LS(TAB))  &kp LC(TAB)  &none  &none  &kp PAGE_UP    &kp HOME           &kp UP_ARROW    &kp END          &kp TAB
&kp LEFT_GUI      &kp LEFT_ALT &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp ESCAPE     &kp PAGE_DOWN  &kp LEFT_ARROW     &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp ENTER
&kp LG(Z)     &kp LG(X)     &kp LG(C)         &kp LG(V)       &kp SPACE      &none          &kp LA(BACKSPACE)  &kp BACKSPACE   &kp DELETE       &kp LA(DELETE)
                              &trans            &trans          &trans         &trans         &trans             &trans
            >;
        };

        mac_num_layer {
            bindings = <
&none  &kp LC(LS(TAB))  &kp LC(TAB)  &none  &none   &none   &kp N7  &kp N8  &kp N9  &none
&kp LEFT_GUI     &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp ESCAPE       &none   &kp N4  &kp N5  &kp N6  &kp N0
&kp LG(Z)        &kp LG(X)     &kp LG(C)         &kp LG(V)       &kp SPACE        &none   &kp N1  &kp N2  &kp N3  &none
                                  &trans            &trans          &trans           &trans  &trans  &trans
            >;
        };

        mac_fn_layer {
            bindings = <
&bt BT_CLR    &mac_bt       &pc1_bt           &pc2_bt        &bt BT_DISC 0  &kp PRINTSCREEN  &kp F7  &kp F8  &kp F9  &kp F12
&kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT &kp ESCAPE    &none            &kp F4  &kp F5  &kp F6  &kp F10
&kp LG(Z)     &kp LG(X)     &kp LG(C)         &kp LG(V)      &none         &none            &kp F1  &kp F2  &kp F3  &to PC_BASE
                              &trans            &trans         &trans        &trans           &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        pc_fn_layer_cond {
            if-layers = <PC_NUM PC_NAV>;
            then-layer = <PC_FN>;
        };

        mac_fn_layer_cond {
            if-layers = <MAC_NUM MAC_NAV>;
            then-layer = <MAC_FN>;
        };
    };
};
